      "namedRegex": "^/catalog(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/create",
      "regex": "^/dashboard/create(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/create(?:/)?$"
    },
    {
      "page": "/dashboard/host",
      "regex": "^/dashboard/host(?:/)?$",
