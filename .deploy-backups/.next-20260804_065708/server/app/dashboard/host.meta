{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/host/layout,_N_T_/dashboard/host/page,_N_T_/dashboard/host"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/host/__PAGE__",
    "/dashboard/host",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}